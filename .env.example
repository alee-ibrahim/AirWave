# Copy to `.env`. Used by docker-compose.

# Password the broadcaster must enter to go live.
BROADCAST_PASSWORD=change-me

# Listener access key. Empty = public (anyone with the link can listen).
# Set a random value to make listening private: the invite link becomes
# /listen?k=<this>, and the audio (/hls/*) is gated by it. Change it to revoke.
LISTEN_KEY=

# Recording feature master switch (1 = allow; 0 = disable entirely).
# When enabled, the broadcaster still opts in per session via a checkbox.
RECORD=1

# Cloudflare *named* tunnel token (stable URL on your own domain).
# Zero Trust dashboard -> Networks -> Tunnels -> Create a tunnel -> copy the token.
# Then add a Public Hostname routing your domain to Service http://app:8080
# (Leave blank only if you switch docker-compose.yml to the quick-tunnel command.)
TUNNEL_TOKEN=
